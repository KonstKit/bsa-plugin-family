{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kkitanin/bsa-plugin-family/schemas/c4_anchor_manifest.schema.json",
  "title": "C4-PlantUML sidecar anchor manifest",
  "description": "Schema for analysis/views/c4/anchor_manifest.json produced in orchestrated mode. Required by ART-VAL-001-07 (anchor manifest required) per skills/bsa-orchestrator/references/sidecar-integration.md. Consumed by the orchestrator's sidecar validator and by future downstream regression tooling.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "generated_at",
    "sidecar",
    "canon_policy_version",
    "view_files"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sidecar": {
      "type": "string",
      "const": "c4-plantuml-from-context"
    },
    "sidecar_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "canon_policy_version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:\\+hash:[a-f0-9]{6,64})?$|^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "view_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "diagram_type", "anchor_map"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "\\.puml$"
          },
          "diagram_type": {
            "type": "string",
            "enum": [
              "System Context",
              "Container",
              "Component",
              "Dynamic",
              "Deployment",
              "System Landscape"
            ]
          },
          "anchor_map": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["view_element_id", "view_element_kind", "a61_anchor_id"],
              "properties": {
                "view_element_id": {
                  "type": "string",
                  "minLength": 1
                },
                "view_element_kind": {
                  "type": "string",
                  "enum": [
                    "Person",
                    "System",
                    "System_Ext",
                    "Container",
                    "Container_Ext",
                    "Component",
                    "Component_Ext",
                    "Rel",
                    "System_Boundary",
                    "Container_Boundary",
                    "Deployment_Node",
                    "Enterprise_Boundary"
                  ]
                },
                "a61_anchor_id": {
                  "type": "string",
                  "pattern": "^ANC-[A-Z0-9_-]+$"
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
