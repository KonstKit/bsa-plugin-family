<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_04d"
                  targetNamespace="http://example.com/fixtures">
  <bpmn:collaboration id="Collab_04d">
    <bpmn:participant id="Participant_04d" processRef="Process_04d" />
  </bpmn:collaboration>
  <bpmn:process id="Process_04d" isExecutable="false">
    <bpmn:laneSet id="LaneSet_04d">
      <bpmn:lane id="Lane_04d" name="Main Lane">
        <bpmn:flowNodeRef>Start_04d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_04d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_04d</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_04d" />
    <bpmn:task id="Task_04d" />
    <bpmn:endEvent id="End_04d" />
    <bpmn:sequenceFlow id="Flow_04d_1" sourceRef="Start_04d" targetRef="Task_04d" />
    <bpmn:sequenceFlow id="Flow_04d_2" sourceRef="Task_04d" targetRef="End_04d" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_04d">
    <bpmndi:BPMNPlane id="BPMNPlane_04d" bpmnElement="Collab_04d">
      <bpmndi:BPMNShape id="Participant_04d_di" bpmnElement="Participant_04d" isHorizontal="true"><dc:Bounds x="40" y="40" width="520" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_04d_di" bpmnElement="Lane_04d" isHorizontal="true"><dc:Bounds x="70" y="70" width="490" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_04d_di" bpmnElement="Start_04d"><dc:Bounds x="120" y="140" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_04d_di" bpmnElement="Task_04d"><dc:Bounds x="220" y="120" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_04d_di" bpmnElement="End_04d"><dc:Bounds x="390" y="140" width="36" height="36" /></bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
