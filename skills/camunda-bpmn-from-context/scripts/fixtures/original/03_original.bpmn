                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_03"
                  targetNamespace="http://example.com/fixtures">
  <bpmn:process id="Process_03" isExecutable="false">
    <bpmn:startEvent id="Start_03" />
    <bpmn:complexGateway id="Gateway_03" />
    <bpmn:endEvent id="End_03" />
    <bpmn:sequenceFlow id="Flow_03_1" sourceRef="Start_03" targetRef="Gateway_03" />
    <bpmn:sequenceFlow id="Flow_03_2" sourceRef="Gateway_03" targetRef="End_03" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_03">
    <bpmndi:BPMNPlane id="BPMNPlane_03" bpmnElement="Process_03">
      <bpmndi:BPMNShape id="Start_03_di" bpmnElement="Start_03"><dc:Bounds x="100" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_03_di" bpmnElement="Gateway_03" isMarkerVisible="true"><dc:Bounds x="220" y="96" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_03_di" bpmnElement="End_03"><dc:Bounds x="360" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_03_1_di" bpmnElement="Flow_03_1"><di:waypoint x="136" y="118" /><di:waypoint x="220" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_2_di" bpmnElement="Flow_03_2"><di:waypoint x="270" y="118" /><di:waypoint x="360" y="118" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
