<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0">
  <bpmn:process id="SmokeProcess8TimerPath" name="Camunda 8 Timer Path" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" />
    <bpmn:intermediateCatchEvent id="Catch_Timer_1">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration>PT1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_Start_To_Catch" sourceRef="StartEvent_1" targetRef="Catch_Timer_1" />
    <bpmn:sequenceFlow id="Flow_Catch_To_End" sourceRef="Catch_Timer_1" targetRef="EndEvent_1" />
  </bpmn:process>
</bpmn:definitions>
