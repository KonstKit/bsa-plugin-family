<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0">
  <bpmn:process id="SmokeProcess8Failing" name="Camunda 8 Failing Smoke Fixture" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" />
    <bpmn:userTask id="UserTask_1" name="Invalid user task">
      <bpmn:extensionElements>
        <zeebe:userTask>
          <zeebe:priorityDefinition priority="101" />
        </zeebe:userTask>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_Start_To_Task" sourceRef="StartEvent_1" targetRef="UserTask_1" />
    <bpmn:sequenceFlow id="Flow_Task_To_End" sourceRef="UserTask_1" targetRef="EndEvent_1" />
  </bpmn:process>
</bpmn:definitions>
