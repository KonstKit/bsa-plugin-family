{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bsa-plugin-family.local/schemas/request_skill_routes.schema.json",
  "title": "BSA Request-Skill Routing Manifest",
  "description": "Schema for config/request_skill_routes.json (US-S05-02). Declares which skill sets are mandatory for each supported request type and how sidecars may attach.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canon_policy_version", "routes"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional pointer to this schema for editor support."
    },
    "_description": {
      "type": "string",
      "description": "Human-readable purpose of the document; ignored by validators."
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Major schema version. Increment on breaking shape changes."
    },
    "canon_policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:\\+hash:[A-Za-z0-9]+)?$",
      "description": "CanonPolicyVersion under which this routing manifest is authoritative. Sprint 3 US-S3-04 extends this to policy-state hash."
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_type", "description", "worker_set"],
        "properties": {
          "request_type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Lower-snake-case identifier for the request."
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "worker_set": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "description": "Skills that MUST be included for this request type. The orchestrator skill itself must appear in every set."
          },
          "conditional_workers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["worker", "trigger"],
              "properties": {
                "worker": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "trigger": {
                  "type": "string",
                  "minLength": 10
                }
              }
            }
          },
          "runtime_notes": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "sidecars": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "policy"],
        "properties": {
          "skill": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "policy": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  }
}
