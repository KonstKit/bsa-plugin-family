<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_01"
                  targetNamespace="http://example.com/fixtures">
  <bpmn:process id="Process_01" isExecutable="false">
    <bpmn:startEvent id="Start_01" />
    <bpmn:task id="Task_01" />
    <bpmn:endEvent id="End_01" />
    <bpmn:sequenceFlow id="Flow_01_1" sourceRef="Start_01" targetRef="Task_01" />
    <bpmn:sequenceFlow id="Flow_01_2" sourceRef="Task_01" targetRef="End_01" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_01">
    <bpmndi:BPMNPlane id="BPMNPlane_01" bpmnElement="Process_01">
      <bpmndi:BPMNShape id="Start_01_di" bpmnElement="Start_01"><dc:Bounds x="100" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_01_di" bpmnElement="Task_01"><dc:Bounds x="200" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_01_di" bpmnElement="End_01"><dc:Bounds x="360" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_1_di" bpmnElement="Flow_01_1"><di:waypoint x="136" y="118" /><di:waypoint x="200" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_01_2_di" bpmnElement="Flow_01_2"><di:waypoint x="300" y="118" /><di:waypoint x="360" y="118" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
