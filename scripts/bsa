#!/usr/bin/env bash
# bsa — shell entry point for the BSA workspace CLI.
#
# Thin wrapper that locates the plugin repo from its own realpath
# (same lockdown as hooks/pre_write_canonical.sh per v1.0.2 C3) and
# invokes bsa_cli.py. Using bash rather than a pip-installable
# console_script keeps the plugin install-path flat — no setup.py /
# pyproject.toml required just to get `bsa` on the path.
#
# Install: symlink into a directory on $PATH, e.g.
#   ln -s /path/to/bsa-plugin-family/scripts/bsa ~/.local/bin/bsa
# Or add scripts/ to $PATH directly.
#
# IMPORTANT: we resolve the script's OWN path via symlinks (not just
# the invoking command's dirname). Without realpath-on-$0, the symlink
# install mode above breaks — $(dirname "$0") returns the symlink
# directory (e.g. ~/.local/bin), not the plugin's scripts/ directory.
# Python's os.path.realpath is portable across macOS (where coreutils'
# readlink -f is not available by default) and Linux, so we use it.
#
# Usage: see `bsa --help`.

set -euo pipefail

SCRIPT_PATH="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$0")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd -P)"
PLUGIN_REPO="$(cd "${SCRIPT_DIR}/.." && pwd -P)"

if [ ! -d "${PLUGIN_REPO}/governance/schemas" ]; then
  echo "[bsa] error: cannot locate plugin repo root from ${SCRIPT_DIR}" >&2
  echo "      expected governance/schemas/ at ${PLUGIN_REPO}" >&2
  exit 2
fi

exec python3 "${PLUGIN_REPO}/scripts/bsa_cli.py" "$@"
